{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"$ROOT_URI/testdata/lsp/workspace/main.domain","languageId":"htn","version":1,"text":"(:include \"base.domain\")\n(:domain Main top_level_domain\n    (:method (run ?inp_target) top_level_method\n        (branch_combat (and (enemy ?enemy) (distance ?enemy ?distance) (not (#is_safe ?enemy)))\n            ((Base::do_combat ?enemy) (!move @speed) (&work ?distance)))\n        (branch_idle () ((work) (work 1))))\n\n    (:method (work)\n        (branch_rest () ((!rest))))\n\n    (:method (work ?inp_amount)\n        (branch_work (and (not (tired ?inp_amount))) ((!work ?inp_amount))))\n\n    (:axiom (is_safe ?inp_entity)\n        (and (#Base::is_hurt ?inp_entity) (cover ?inp_entity @cover)))\n)\n"}}}
