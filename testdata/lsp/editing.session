{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"$ROOT_URI/testdata/lsp/workspace/base.domain","languageId":"htn","version":1,"text":"// Included by main.domain in the language server sessions.\n(:domain Base base\n    (:constants\n        (speed 3)\n        (cover \"wall\"))\n\n    (:axiom (is_hurt ?inp_entity)\n        (and (health ?inp_entity ?health) (< ?health 50)))\n\n    (:method (fight ?inp_threat)\n        (branch_attack (and (#is_hurt ?inp_threat)) ((!attack ?inp_threat)))\n        (branch_wait () ((!wait))))\n)\n"}}}
