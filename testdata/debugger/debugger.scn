fact route_blocked 2
fact route_blocked 3
mode facts_and_axioms
remove_fact event_dangerous 1 0
raw run_include_demo
end

scenario selected/fuzz/Wanderer/1-2
planner Wanderer
policy report
debugger on
fact pathfind_state succeeded in_progress 0 4
fact pathfind_state succeeded 4 "One coordinate is even and the other is odd!" "One coordinate is even and the other is odd!"
fact pathfind_state succeeded 3 3 ("One coordinate is even and the other is odd!")
fact pathfinder "Already at location " contextual walking 3
fact pathfinder succeeded "text" "text" in_progress
fact pathfinding_segment "Both coordinates are odd!" contextual sym
fact wanderer_destination "Already at location "
fact wanderer_location (0 0)
fact wanderer_location 1.5
fact wanderer_state walking
fact wanderer_state walking
call run
resolve
call run
resolve
end

scenario selected/ComplexScenario/idle
planner ComplexScenario
debugger on
policy report
worldstate WorldStates/Test/complex_scenario_idle.worldstate
call run_scenario
resolve
raw run_scenario
rawdeferred run_scenario
call no_such_method
end

scenario selected/recursion_small_frames
planner RecursionDispatchSmallFrames
debugger on
fact depth 3
raw non_tail
raw mutual
raw deep_failure
remove_fact depth 1 0
fact depth 6
raw non_tail
raw mutual
raw deep_failure
remove_fact depth 1 0
fact depth 7
raw non_tail
raw mutual
raw deep_failure
end
