domain AAACombatNPC method run
run WorldStates/AAACombatNPC_high_order.worldstate None
status SUCCEEDED
step !announce_state "high_order" 1
step !mark_order_started 1 evacuate
step !deploy_smoke 1
step !move_to_order_target 1 "extraction_zone"
step !mark_order_complete 1 evacuate
run WorldStates/AAACombatNPC_high_order.worldstate Facts and axioms
status SUCCEEDED
step !announce_state "high_order" 1
step !mark_order_started 1 evacuate
step !deploy_smoke 1
step !move_to_order_target 1 "extraction_zone"
step !mark_order_complete 1 evacuate
run WorldStates/AAACombatNPC_high_order.worldstate Branches
status SUCCEEDED
step !announce_state "high_order" 1
step !mark_order_started 1 evacuate
step !deploy_smoke 1
step !move_to_order_target 1 "extraction_zone"
step !mark_order_complete 1 evacuate
run WorldStates/AAACombatNPC_high_order.worldstate All
status SUCCEEDED
step !announce_state "high_order" 1
step !mark_order_started 1 evacuate
step !deploy_smoke 1
step !move_to_order_target 1 "extraction_zone"
step !mark_order_complete 1 evacuate
run WorldStates/AAACombatNPC_high_order.worldstate All
status SUCCEEDED
step !announce_state "high_order" 1
step !mark_order_started 1 evacuate
step !deploy_smoke 1
step !move_to_order_target 1 "extraction_zone"
step !mark_order_complete 1 evacuate
run WorldStates/AAACombatNPC_idle.worldstate All
status SUCCEEDED
step !announce_state "idle" 1
step !follow_patrol_route 1 "north_loop"
step !inspect_checkpoint 1 "checkpoint_alpha"
step !report_patrol_progress 1 "checkpoint_alpha"
run WorldStates/AAACombatNPC_investigation.worldstate All
status SUCCEEDED
step !announce_state "investigation" 1
step !move_to_cover 1 "pillar_7"
step !report_suspicious_sound 1 "upper_walkway"
step !scan_sector 1 "upper_walkway"
run WorldStates/AAACombatNPC_low_order.worldstate All
status SUCCEEDED
step !announce_state "low_order" 1
step !mark_order_started 1 guard
step !guard_target 1 "west_gate"
run WorldStates/AAACombatNPC_medium_order.worldstate All
status SUCCEEDED
step !announce_state "medium_order" 1
step !mark_order_started 1 escort
step !follow_escort_route 1 "scientist" "service_tunnel"
run WorldStates/AAACombatNPC_melee.worldstate All
status SUCCEEDED
step !announce_state "combat" 1
step !switch_weapon 1 melee
step !quick_melee_attack 1 202
run WorldStates/AAACombatNPC_ranged.worldstate All
status SUCCEEDED
step !announce_state "combat" 1
step !switch_weapon 1 ranged
step !aim_at 1 302
step !fire_controlled_burst 1 302
run WorldStates/AAACombatNPC_search.worldstate All
status SUCCEEDED
step !announce_state "search" 1
step !announce_lost_enemy 1 501
step !follow_enemy_tracks 1 "muddy_corridor"
step !scan_sector 1 "warehouse"
