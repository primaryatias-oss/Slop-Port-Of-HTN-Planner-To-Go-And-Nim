scenario Human/human
call behave
status SUCCEEDED
plan 3
step !take "apple"
step !peel "apple"
step !eat "apple"
resolve
exec !take "apple"
exec !peel "apple"
exec !eat "apple"
resolution completed
raw behave
status SUCCEEDED
info peak=6 capacity=8192 error=-
plan 3
step !take "apple"
step !peel "apple"
step !eat "apple"
rawdeferred behave
status SUCCEEDED
info peak=6 capacity=8192 error=-
plan 3
step !take "apple"
step !peel "apple"
step !eat "apple"
call behave_upper_body
status SUCCEEDED
plan 1
step !talk "This fruit is very tasty!"
resolve
exec !talk "This fruit is very tasty!"
resolution completed
raw behave_upper_body
status SUCCEEDED
info peak=2 capacity=8192 error=-
plan 1
step !talk "This fruit is very tasty!"
rawdeferred behave_upper_body
status SUCCEEDED
info peak=2 capacity=8192 error=-
plan 1
step !talk "This fruit is very tasty!"
call behave 1
status INVALID_CALL
plan 0
resolve
resolution completed
raw behave 1
status INVALID_CALL
info peak=0 capacity=8192 error=-
plan 0
rawdeferred behave 1
status INVALID_CALL
info peak=0 capacity=8192 error=-
plan 0
call no_such_method
status INVALID_CALL
plan 0
end
scenario Human/axiom_backtracking
