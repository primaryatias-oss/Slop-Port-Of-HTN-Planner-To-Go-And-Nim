step !take "orange"
step !eat "orange"
rawdeferred behave
trace binded_function_with_args("we are doing nothing") -> true
status SUCCEEDED
info peak=5 capacity=8192 error=-
plan 2
step !take "orange"
step !eat "orange"
call behave_upper_body
status SUCCEEDED
plan 1
step !log "Error"
resolve
