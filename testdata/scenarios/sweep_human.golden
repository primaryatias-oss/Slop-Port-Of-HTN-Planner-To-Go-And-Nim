status SUCCEEDED
info peak=2 capacity=8192 error=-
plan 1
step !log "Error"
rawdeferred behave_upper_body
status SUCCEEDED
info peak=2 capacity=8192 error=-
plan 1
step !log "Error"
call behave 1
status INVALID_CALL
plan 0
resolve
resolution completed
raw behave 1
status INVALID_CALL
info peak=0 capacity=8192 error=-
plan 0
rawdeferred behave 1
status INVALID_CALL
info peak=0 capacity=8192 error=-
plan 0
call no_such_method
status INVALID_CALL
plan 0
end
