scenario BuiltinComparisonsDemo/critical
call run
status SUCCEEDED
plan 1
step !report_comparison_case "critical_close_combat" 20 3 6 combat
resolve
exec !report_comparison_case "critical_close_combat" 20 3 6 combat
resolution completed
raw run
status SUCCEEDED
info peak=2 capacity=8192 error=-
plan 1
step !report_comparison_case "critical_close_combat" 20 3 6 combat
rawdeferred run
status SUCCEEDED
info peak=2 capacity=8192 error=-
plan 1
step !report_comparison_case "critical_close_combat" 20 3 6 combat
call no_such_method
status INVALID_CALL
plan 0
end
